{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "types": ["cypress", "node"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": "..",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["./**/*.ts", "../src/test/msw/fixtures/**/*.ts"]
}
