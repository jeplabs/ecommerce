# Copia este archivo, renombralo a application-dev.properties
# y rellena con tus credenciales locales

# Base de datos local
spring.datasource.url=jdbc:postgresql://localhost:5432/NOMBRE_BASE_DATOS
spring.datasource.username=USUARIO_POSTGRES
spring.datasource.password=PASSWORD_POSTGRES

# JWT
api.security.secret=CUALQUIER_STRING_LARGO_PARA_DEV
# Tiempo expiration en segundos
api.security.expiration=7200

# Tiempo de expiración del token de restablecimiento de contraseña en minutos
api.security.reset-token-expiracion-minutos=30

# spring.jpa.show-sql=false

# Minutos que dura el bloqueo por intentos fallidos
api.security.lockout-minutes=2

# Email
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=TU_EMAIL_GMAIL
spring.mail.password=TU_PASSWORD_DE_APLICACION_GMAIL
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.default-encoding=UTF-8

# Carrito
api.carrito.expiracion-minutos=30
api.carrito.notificacion-minutos-antes=10
api.carrito.scheduler-intervalo=PT2M
api.carrito.scheduler-delay-inicial=PT30S
api.carrito.dias-retencion-expirados=30

# Orden (Scheduler de expiración)
api.orden.scheduler.enabled=true
api.orden.expiracion-minutos=10
api.orden.expiracion-fixed-delay-ms=300000
api.orden.expiracion-delay-inicial-ms=120000

# Porcentaje IVA
api.impuestos.iva=0.12

# Servicios de envio
api.envio.monto-minimo-gratis=500.00

# Storage
# api.storage.provider=local
api.storage.provider=cloudinary
# api.storage.local.path=uploads/comprobantes
# api.storage.allowed-types=image/png,image/jpeg,application/pdf
# api.storage.max-size-mb=5

# Cloudinary
api.storage.cloudinary.cloud-name=CLOUDINARY_CLOUD_NAME
api.storage.cloudinary.api-key=CLOUDINARY_API_KEY
api.storage.cloudinary.api-secret=CLOUDINARY_API_SECRET

# Moneda
api.moneda.codigo=GTQ
api.moneda.simbolo=Q
api.moneda.nombre=Quetzal
api.moneda.locale=es-GT
api.moneda.decimales=2

# Moneda - Peso chileno
api.moneda.codigo=CLP
api.moneda.simbolo=$
api.moneda.nombre=Peso Chileno
api.moneda.locale=es-CL
api.moneda.decimales=0

# Webpay Plus
api.webpay.ambiente=integracion
# Credenciales de produccion (vacias en dev, el SDK usa las de integracion automaticamente)
api.webpay.commerce-code=
api.webpay.api-key=
api.webpay.return-url=http://localhost:5173/checkout/webpay/retorno
api.webpay.webhook-secret=SECRET_WEBHOOK

# Webpay Plus - Scheduler de Reconciliación
# Habilita o deshabilita la tarea automática (true por defecto)
api.webpay.scheduler.enabled=true

# Cada cuánto tiempo se ejecuta la revisión (cada 15 minutos)
api.webpay.scheduler.intervalo=PT15M

# Cuánto tiempo espera la app tras arrancar antes de la 1ra ejecución (1 minuto)
api.webpay.scheduler.delay-inicial=PT1M

# ==========================================
# QPayPro Integration (Sandbox / Pruebas)
# ==========================================
qpaypro.api.login=visanetgt_qpay
qpaypro.api.key=88888888888
qpaypro.api.secret=99999999999

# Endpoints
qpaypro.api.url=https://api-sandboxpayments.qpaypro.com/checkout
qpaypro.api.store-url=https://sandboxpayments.qpaypro.com/checkout/store?token=
qpaypro.api.fel-url=https://api-sandboxpayments.qpaypro.com/checkout/qpayfel/facturar

# URL base local para recibir el webhook de retorno
api.base-url=http://localhost:8080

# Secreto para la validación de integridad MD5 (firma local)
qpaypro.api.webhook-secret=MI_SECRETO_MD5

# ==========================================
# Frontend Configuration
# ==========================================
# URL base de la aplicación React/Vite local
frontend.url=http://localhost:5173